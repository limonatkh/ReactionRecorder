<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- استقبال نداء الجوال الرئيسي على الشبكة المحلية (للرجوع التلقائي بعد الانقطاع) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 9 وأقل لا يلزمهما؛ minSdk=29 والحفظ عبر MediaStore لا يحتاج صلاحية تخزين -->

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReactionRecorder">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:launchMode="singleTask" />

        <activity android:name=".JoinActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".VlogActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" android:screenOrientation="fullSensor" />
        <activity android:name=".LockActivity" android:exported="false" android:screenOrientation="portrait" android:excludeFromRecents="true" />
        <activity android:name=".LicenseActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SourceEditActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".IntroPickActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".WebJoinActivity" android:exported="false" />
        <activity android:name=".FramingActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity android:name=".TemplateActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".TemplateEditActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".BoardActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard" android:windowSoftInputMode="adjustNothing" />
        <activity android:name=".RecordingsActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".SessionActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".SettingsActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MonitorActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" android:screenOrientation="fullSensor" />

        <activity
            android:name=".DevicesActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SatelliteActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".StudioActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PodcastActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="fullSensor"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PodcastEditActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PodcastShortsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <activity
            android:name=".PodPreviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".PodcastExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".WebHubService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".SatelliteService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <service
            android:name=".ReplayService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|camera|microphone" />

    </application>
</manifest>
